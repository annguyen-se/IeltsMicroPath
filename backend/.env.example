PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/ieltstrain?retryWrites=true&w=majority
JWT_SECRET=super_secret_jwt_key_change_in_production_min32chars!
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173

# ── TTS Hybrid (Kokoro batch + edge-tts fallback) ──
# Kokoro-FastAPI local Docker: docker run -p 8880:8880 ghcr.io/remsky/kokoro-fastapi:latest
KOKORO_TTS_URL=http://localhost:8880/v1/audio/speech
TTS_VOICE_KOKORO=bf_emma
TTS_VOICE_EDGE=en-GB-SoniaNeural
# Public origin where generated /audio/*.mp3 files are served
AUDIO_BASE_URL=http://localhost:5000
